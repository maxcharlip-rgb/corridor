# Copy to .env and fill in what you need. Nothing here is required to run
# Corridor — previews, publishing, lead capture and analytics all work unset.

PORT=4182

# Public origin used for shareable tour links AND for the image URLs handed to
# Higgsfield. Higgsfield downloads your photos over the internet, so Cinematic
# rendering needs this to be publicly reachable (e.g. a cloudflared/ngrok
# tunnel). Preview rendering does not care.
# PUBLIC_URL=https://your-tunnel.example.com

# --- Higgsfield (Cinematic quality) -----------------------------------------
# From https://platform.higgsfield.ai — the API sends "Authorization: Key ID:SECRET".
# HIGGSFIELD_KEY_ID=
# HIGGSFIELD_KEY_SECRET=

# dop-turbo (fast, cheapest) | dop-lite | dop-preview (highest quality)
# HIGGSFIELD_MODEL=dop-turbo

# Optional: pin specific Higgsfield motion UUIDs. Without these, the camera move
# is driven by prompt language alone, which the DoP models honour well. Add a
# UUID here if you want the exact catalogued motion instead.
# HIGGSFIELD_MOTION_DOLLY_IN=
# HIGGSFIELD_MOTION_PUSH_FORWARD=
# HIGGSFIELD_MOTION_ORBIT_360=
# HIGGSFIELD_MOTION_CRANE_UP=
# HIGGSFIELD_MOTION_PULL_BACK=
# HIGGSFIELD_MOTION_TILT_UP=
# HIGGSFIELD_MOTION_TRUCK_LATERAL=
# HIGGSFIELD_MOTION_STATIC_HOLD=
# HIGGSFIELD_MOTION_BLEND_TRANSITION=

# --- Spend guards -----------------------------------------------------------
# Hard ceiling on Higgsfield credits per calendar month. Generation is refused
# with HTTP 402 before the call is made once the projected spend exceeds this.
# Leave unset for no ceiling (logged at startup so it stays a deliberate choice).
# CREDIT_BUDGET=3000

# --- Claude API (for the prospect Q&A chat — not yet implemented) ------------
# ANTHROPIC_API_KEY=

# --- Virtual staging (optional) ---------------------------------------------
# Any image-edit endpoint that accepts {image_url, prompt} and returns {url}.
# Photos staged this way are permanently badged "Virtually staged" in the tour.
# STAGING_ENDPOINT=
# STAGING_API_KEY=

# --- Paths (only if ffmpeg isn't auto-discovered) ----------------------------
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
