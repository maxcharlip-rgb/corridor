# Corridor — environment
# Copy to .env. Nothing here is required to boot; the app runs with none of it set.

# Origin used for shareable tour links AND for the photo URLs handed to
# Higgsfield. Must be publicly reachable for cinematic renders (use a tunnel
# such as cloudflared/ngrok in development). Defaults to http://localhost:4182.
PUBLIC_URL=

# HTTP port. Defaults to 4182.
PORT=

# Session cookie signing. If unset, a per-install secret is generated into
# data/db.json with a warning. SET THIS before deploying anywhere real —
# rotating it signs everyone out.
SESSION_SECRET=

# Cinematic generation (Higgsfield). Without both, cinematic rendering is
# disabled; local preview rendering, publishing, QR sign kit and sharing all
# still work. Auth header is "Key ID:SECRET" — not Bearer.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=

# Optional Higgsfield overrides.
# HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai
# HIGGSFIELD_MODEL=dop-turbo
# HIGGSFIELD_POLL_MS=5000
# HIGGSFIELD_TIMEOUT_MS=600000

# Hard monthly ceiling on generation spend. Generation returns 402 past it.
# Strongly recommended in any hosted deployment.
CREDIT_BUDGET=

# Optional. Spec extraction from free text; degrades to a heuristic parse
# without it.
ANTHROPIC_API_KEY=

# Optional explicit binary paths if discovery fails (ffmpeg-static is bundled).
# FFMPEG_PATH=
# FFPROBE_PATH=

# --- Deployment / operations -------------------------------------------------
# Where runtime state lives. Point at a mounted volume in a container, or state
# dies with the container. Defaults to ./data.
# CORRIDOR_DATA_DIR=

# Override the image-generation path if Higgsfield's differs. Note: Higgsfield
# checks auth BEFORE routing, so a wrong path returns 401, not 404 — validate
# credentials first with `npm run doctor`.
# HIGGSFIELD_IMAGE_PATH=

# A generation with no result after this long is marked failed so it cannot
# poll forever. Default 45 minutes.
# JOB_STALE_MS=2700000

# Unreferenced render files older than this are swept. Files still referenced by
# a shot, take, reel or visual are never removed. Default 30 days.
# RENDER_RETENTION_DAYS=30

# --- Virtual staging (optional) ----------------------------------------------
# An image-edit endpoint taking {image_url, prompt} and returning {url}. Photos
# staged this way are permanently badged "Virtually staged" in the public tour.
# STAGING_ENDPOINT=
# STAGING_API_KEY=

# Model used for spec extraction and the (unmounted) tour chat.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Port used by `npm test` only. Defaults to 4287.
# TEST_PORT=
